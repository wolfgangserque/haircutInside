---
import { getPage } from "@lib/contentParser.astro";
import Layout from '@layouts/Layout.astro';
import Banner from "@components/Banner";
import harga from '../../harga.json';

const formatPrice = (item: { price: number; note?: string }) =>
  item.note ?? `Rp ${item.price.toLocaleString('id-ID')}`;

// Foto utama diambil dari /public/images lokal (per kategori) supaya nanti
// tinggal ganti file-nya. Selama file lokal belum ada, otomatis fallback ke stok luar.
const imgFallback = (url: string) => `this.onerror=null;this.src='${url}'`;

const homepage = await getPage('pages', '-index');
const { banner } = homepage?.data ?? {};

const seoTitle = "Barbershop Terbaik di Harapan Indah Bekasi | Haircut Inside Barbershop";
const seoDesc  = "Haircut Inside Barbershop adalah barbershop premium di Harapan Indah Bekasi yang menyediakan potong rambut pria, fade haircut, cuci rambut, dan layanan grooming profesional.";
const seoKw    = "Barbershop Harapan Indah, Pangkas Rambut Harapan Indah, Barbershop Bekasi, Barbershop Terdekat, Potong Rambut Pria, Hair Studio Harapan Indah, Barbershop Inside, barbershop terbaik Harapan Indah Bekasi";

const layanan = [
  {
    title: "Potong Rambut Pria",
    desc: "Potong rambut pria profesional dengan hasil presisi. Barber berpengalaman siap memberikan gaya terbaik sesuai karakter wajah dan selera Anda di Harapan Indah Bekasi."
  },
  {
    title: "Fade Haircut",
    desc: "Spesialis fade haircut — skin fade, low fade, mid fade, high fade. Teknik blending sempurna untuk tampilan modern dan rapi khas barbershop Bekasi."
