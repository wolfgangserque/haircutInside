// 1 model rambut = 1 foto, kecuali Hair Design (boleh 2 foto/angle) — total 7 foto.
// Foto lokal per capster belum tersedia, sementara pakai fallback dari Unsplash
// (isTemporaryImage) sampai foto asli klien di-upload ke folder ini.
const galeri = [
  { src: "/images/gallery/capster-1/01.jpg", fallback: "https://images.unsplash.com/photo-1599351431202-1e0f0137899a?w=900&auto=format&q=80", alt: "Hasil fade haircut rapi oleh Stenly di Haircut Inside Barbershop Harapan Indah Bekasi", wide: true, capster: "capster-1", isTemporaryImage: true },
  { src: "/images/gallery/capster-1/02.jpg", fallback: "https://images.unsplash.com/photo-1568339434343-2a640a1a9946?w=900&auto=format&q=80", alt: "Hair design pola shaved art karya Stenly di Haircut Inside Barbershop Harapan Indah", wide: true, capster: "capster-1", isTemporaryImage: true },
  { src: "/images/gallery/capster-1/03.jpg", fallback: "https://images.unsplash.com/photo-1635273051937-a0ddef9573b6?w=600&auto=format&q=80", alt: "Proses pengerjaan hair design dari sisi lain oleh Stenly di Haircut Inside Barbershop", wide: false, capster: "capster-1", isTemporaryImage: true },
  { src: "/images/gallery/capster-2/01.jpg", fallback: "https://images.unsplash.com/photo-1705247815016-fb23ebf07a44?w=600&auto=format&q=80", alt: "Korean style haircut modern hasil karya Matthew di Haircut Inside Barbershop Harapan Indah", wide: false, capster: "capster-2", isTemporaryImage: true },
  { src: "/images/gallery/capster-2/02.jpg", fallback: "https://images.unsplash.com/photo-1618049049816-43a00d5b0c3d?w=600&auto=format&q=80", alt: "Down perm rambut pria hasil karya Matthew di Haircut Inside Barbershop Harapan Indah Bekasi", wide: false, capster: "capster-2", isTemporaryImage: true },
  { src: "/images/gallery/capster-3/01.jpg", fallback: "https://images.unsplash.com/photo-1630827020718-3433092696e7?w=900&auto=format&q=80", alt: "Hair perm rapi hasil karya Shemico di Haircut Inside Barbershop Harapan Indah Bekasi", wide: true, capster: "capster-3", isTemporaryImage: true },
  { src: "/images/gallery/capster-3/02.jpg", fallback: "https://images.unsplash.com/photo-1705247372456-b6ae4b54cc90?w=900&auto=format&q=80", alt: "Hair coloring modern hasil karya Shemico di Haircut Inside Barbershop Harapan Indah Bekasi", wide: true, capster: "capster-3", isTemporaryImage: true }
